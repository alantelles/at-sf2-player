FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libx11-dev \
    libcairo2-dev \
    libpango1.0-dev \
    zip \
    timgm6mb-soundfont \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
